# Ne pas committer les vraies valeurs. Exporter dans le shell avant railway-init-3k.sh :
#
#   export RAILWAY_TOKEN_3K='...'   # Token « Account » depuis https://railway.com/account/tokens
#                                   # (un token « project » ou expiré renvoie Not Authorized sur l’API.)
#   export RAILWAY_WORKSPACE_ID_3K='...'  # UUID du workspace (GraphQL me.workspaces.id).
#   Le nom affiché peut être « 3k-Negoce_workspace » — l’UUID est dans l’URL ou la réponse API.

RAILWAY_TOKEN_3K=
RAILWAY_WORKSPACE_ID_3K=

# Ne pas committer les vraies valeurs. Exporter dans le shell avant railway-init-3k.sh :
#
#   export RAILWAY_TOKEN_3K='...'
#     • Token **compte** : OK pour `railway` CLI + API
#     • Token **workspace** : OK pour l’API ; `railway init` échoue souvent →
#       railway-init-3k.sh utilise alors projectCreate (GraphQL).
#
#   export RAILWAY_WORKSPACE_ID_3K='...'   # UUID du workspace
#     Avec un workspace token : ./scripts/migration-3k/resolve-railway-workspace-3k.sh
#     (la requête `me { workspaces }` ne fonctionne pas avec ce type de token.)
#
# Tokens : https://railway.com/account/tokens

RAILWAY_TOKEN_3K=
RAILWAY_WORKSPACE_ID_3K=

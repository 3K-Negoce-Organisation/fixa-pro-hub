# Flux recommandé : generate-edge-secrets-3k.sh → secrets-edge.<env>.env dans .generated/
# Puis secrets-edge.manual.env pour RESEND / webhooks / n8n (voir secrets-edge.manual.example.env).
# Ce fichier reste un exemple minimal si vous préférez un seul secrets-edge.env sans générateur.

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
N8N_WEBHOOK_URL=
ORDER_UPDATE_API_KEY=
VAB_API_KEY=

# Injectés automatiquement côté plateforme pour les fonctions ; souvent requis aussi en secrets :
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
